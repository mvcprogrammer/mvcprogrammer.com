<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>Experience.Api</AssemblyName>
    <RootNamespace>Experience.Api</RootNamespace>
    <!-- Lambda: the handler in template.yaml is this assembly name. -->
    <AWSProjectType>Lambda</AWSProjectType>
    <!-- Pre-compiles IL to native code at publish time to cut cold start. -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Amazon.Lambda.AspNetCoreServer.Hosting" Version="2.2.1" />
    <PackageReference Include="AWSSDK.DynamoDBv2" Version="4.0.107" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Experience.Api.Tests" />
  </ItemGroup>

</Project>
