{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::mvcprogrammer.com"
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::mvcprogrammer.com/*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::mvcprogrammer.com/stats/data/index.json"
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::mvcprogrammer-cf-logs-334383610383"
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::mvcprogrammer-cf-logs-334383610383/*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateInvalidation"
      ],
      "Resource": [
        "arn:aws:cloudfront::334383610383:distribution/E23085GR2SZJHC",
        "arn:aws:cloudfront::334383610383:distribution/E2NFN5MW02S8Y9",
        "arn:aws:cloudfront::334383610383:distribution/E33NA2ZQ9O29DK",
        "arn:aws:cloudfront::334383610383:distribution/E2C51AKAKJUCBO"
      ]
    }
  ]
}
