@* The FHIR R4 patient explorer inside the FHIR API card's accordion: search, the patient list, the
   summary card, and the "under the hood" log. Rendered only once the accordion opens, so the first
   request to /api/fhir (the capability check) happens then. The markup is the static edition's; ids
   are kept because the shared stylesheet and aria wiring use them. *@
<div class="fhir-explorer">
    <div class="fhir-head">
        <h4 class="fhir-title">FHIR R4 patient explorer</h4>
        <p class="fhir-badge"><span class="fhir-badge-dot" aria-hidden="true"></span>Synthetic data &middot; <span data-fhir-source>@_sourceLabel</span></p>
    </div>
    <p class="fhir-lead">A window onto a public FHIR R4 test server seeded with synthetic records. No real patient data is involved, nothing is persisted, and nothing beyond request metadata is logged.</p>

    @* Search. The example is prefilled so the first click succeeds; the sandbox is wiped now and
       then, so the component replaces a family name that returns nothing with the next one in its list. *@
    <EditForm EditContext="_editContext" OnValidSubmit="SearchAsync" OnInvalidSubmit="ShowInvalid" class="@FormClass" id="fhir-search" role="search" aria-label="Patient search">
        <DataAnnotationsValidator />
        <div class="fhir-search-row">
            <div class="field">
                <label class="field-label" for="fhir-family">Family name <span class="fhir-required" aria-hidden="true">*</span></label>
                <InputText id="fhir-family" @bind-Value="_form.Family" class="@InvalidClass(FamilyError)" aria-invalid="@InvalidAttribute(FamilyError)" required maxlength="@ViewModels.FhirSearchForm.FAMILY_MAX_LENGTH" autocomplete="off" spellcheck="false" aria-describedby="fhir-family-error" />
                <p class="field-error" id="fhir-family-error" aria-live="polite">@FamilyError</p>
            </div>
            <div class="field">
                <label class="field-label" for="fhir-birthdate">Birth date</label>
                <InputText id="fhir-birthdate" type="date" @bind-Value="_form.Birthdate" class="@InvalidClass(BirthdateError)" aria-invalid="@InvalidAttribute(BirthdateError)" autocomplete="off" aria-describedby="fhir-birthdate-error" />
                <p class="field-error" id="fhir-birthdate-error" aria-live="polite">@BirthdateError</p>
            </div>
            <div class="field">
                <label class="field-label" for="fhir-identifier">Identifier <span class="fhir-optional">(MRN, optional)</span></label>
                <InputText id="fhir-identifier" @bind-Value="_form.Identifier" maxlength="@ViewModels.FhirSearchForm.IDENTIFIER_MAX_LENGTH" autocomplete="off" spellcheck="false" placeholder="12345 or system|value" />
                <p class="field-error" aria-live="polite"></p>
            </div>
            <div class="field fhir-search-action">
                <button class="button button-primary" type="submit" id="fhir-submit" disabled="@_searching">Search</button>
            </div>
        </div>
        <p class="@StatusClass" id="fhir-status" role="status" aria-live="polite">
            @if (_statusText.Length == 0)
            {
                <text>Searches <code>GET /api/fhir/patients?family=&hellip;</code>, which runs <code>GET Patient?family=&hellip;</code> on the sandbox.</text>
            }
            else
            {
                @_statusText
            }
        </p>
    </EditForm>

    @* Results: the list on the left, the summary on the right; stacked on phones. *@
    <div class="fhir-results" id="fhir-results">
        <section class="fhir-panel fhir-list" aria-labelledby="fhir-list-title">
            <h5 class="fhir-panel-title" id="fhir-list-title">Patients <span class="fhir-count" id="fhir-count" aria-live="polite">@_countLabel</span></h5>
            <ul class="fhir-patients" id="fhir-patients" role="list">
                @foreach (var patient in _patients ?? [])
                {
                    <li @key="patient.Id">
                        <button type="button" class="fhir-patient" data-id="@patient.Id" aria-pressed="@Pressed(patient.Id)" @onclick="() => SelectAsync(patient.Id)">
                            <span class="@patient.Id.ToAvatarClass(true)" aria-hidden="true">@patient.ToInitials()</span>
                            <span class="fhir-patient-text">
                                <span class="fhir-patient-name">@patient.Name</span>
                                <span class="fhir-patient-sub">@patient.ToRowLabel()</span>
                            </span>
                        </button>
                    </li>
                }
            </ul>
            <p class="fhir-empty" id="fhir-list-empty" hidden="@(_patients is { Count: > 0 })">@_listMessage</p>
        </section>

        <section class="@SummaryClass" id="fhir-summary" aria-labelledby="fhir-summary-title" aria-live="polite" aria-busy="@(_summaryBusy ? "true" : "false")">
            <h5 class="sr-only" id="fhir-summary-title">Patient summary</h5>
            @if (_summary is null)
            {
                <p class="fhir-empty" id="fhir-summary-empty">@_summaryMessage</p>
            }
            else
            {
                <div class="fhir-card" id="fhir-card">
                    <header class="fhir-card-head">
                        <span class="@_summary.Patient.Id.ToAvatarClass(false)" id="fhir-avatar" aria-hidden="true">@_summary.Patient.Initials</span>
                        <div class="fhir-card-ident">
                            <h6 class="fhir-card-name" id="fhir-card-name">@_summary.Patient.Name</h6>
                            <p class="fhir-card-meta" id="fhir-card-meta">@(_summary.Patient.Sex?.ToLabel() ?? "sex unknown") · @_summary.Patient.ToAgeLabel() · <code>Patient/@_summary.Patient.Id</code>@if (!string.IsNullOrEmpty(_summary.Patient.Mrn)) {<text> · MRN <code>@_summary.Patient.Mrn</code></text>}</p>
                        </div>
                    </header>
                    <dl class="fhir-tiles" aria-label="Resource counts">
                        <div class="fhir-tile"><dt>Conditions</dt><dd id="fhir-tile-conditions">@_summary.Counts.Conditions</dd></div>
                        <div class="fhir-tile"><dt>Encounters</dt><dd id="fhir-tile-encounters">@_summary.Counts.Encounters</dd></div>
                        <div class="fhir-tile"><dt>Observations</dt><dd id="fhir-tile-observations">@_summary.Counts.Observations</dd></div>
                    </dl>
                    <h6 class="fhir-subtitle">Active conditions</h6>
                    <ul class="fhir-pills" id="fhir-conditions" role="list">
                        @if (_summary.Conditions.Active.Count == 0 && _summary.Conditions.Resolved.Count == 0)
                        {
                            <li class="fhir-empty-inline">None recorded.</li>
                        }
                        @foreach (var condition in _summary.Conditions.Active)
                        {
                            <li class="fhir-pill" title="@condition.ToPillTitle()">
                                <span class="fhir-pill-text">@condition.Display</span>
                                @if (!string.IsNullOrEmpty(condition.Code))
                                {
                                    <code class="fhir-pill-code">@condition.ToPillCode()</code>
                                }
                            </li>
                        }
                        @if (_summary.Conditions.Resolved.Count > 0)
                        {
                            <li class="fhir-pill fhir-pill-more">
                                <button type="button" class="fhir-pill-button" aria-expanded="@(_resolvedShown ? "true" : "false")" aria-controls="fhir-resolved" @onclick="ToggleResolved">@ResolvedLabel</button>
                            </li>
                        }
                    </ul>
                    <ul class="fhir-pills fhir-pills-resolved" id="fhir-resolved" role="list" hidden="@(!_resolvedShown)">
                        @foreach (var condition in _summary.Conditions.Resolved)
                        {
                            <li class="fhir-pill is-resolved" title="@condition.ToPillTitle()">
                                <span class="fhir-pill-text">@condition.Display</span>
                                @if (!string.IsNullOrEmpty(condition.Code))
                                {
                                    <code class="fhir-pill-code">@condition.ToPillCode()</code>
                                }
                            </li>
                        }
                    </ul>
                    <h6 class="fhir-subtitle">Vitals</h6>
                    <div class="fhir-table-wrap">
                        <table class="fhir-table" id="fhir-vitals" hidden="@(_summary.Vitals.Count == 0)">
                            <thead>
                                <tr><th scope="col">Date</th><th scope="col">Vital sign</th><th scope="col">Value</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var vital in _summary.Vitals)
                                {
                                    var (date, time) = vital.Date.ToDateParts();
                                    <tr>
                                        <td class="fhir-table-date"><time datetime="@vital.Date">@date@if (time.Length > 0) {<span class="fhir-table-time">@time</span>}</time></td>
                                        <td>@vital.Name <code class="fhir-loinc">@vital.LoincCode</code></td>
                                        <td class="fhir-table-value">@vital.ToValueLabel()</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <p class="fhir-empty fhir-vitals-empty" id="fhir-vitals-empty" hidden="@(_summary.Vitals.Count > 0)">No vital signs recorded for this patient.</p>
                </div>
            }
        </section>
    </div>

    @* Under the hood: what the browser asked for, what the function asked the sandbox for, and what came back. *@
    <section class="fhir-hood" aria-labelledby="fhir-hood-title">
        <div class="fhir-hood-head">
            <h5 class="fhir-panel-title" id="fhir-hood-title">Under the hood</h5>
            <div class="fhir-hood-actions">
                <button class="button button-secondary fhir-hood-button" type="button" id="fhir-raw-toggle" aria-expanded="@(_rawOpen ? "true" : "false")" aria-controls="fhir-raw" disabled="@(_summary is null)" @onclick="ToggleRawAsync">View raw bundle</button>
                <a class="card-link" href="https://github.com/mvcprogrammer/mvcprogrammer.com/blob/main/api/openapi.yaml" target="_blank" rel="noopener">OpenAPI</a>
                <a class="card-link" href="https://github.com/mvcprogrammer/mvcprogrammer.com/tree/main/api/src/Fhir.Api" target="_blank" rel="noopener">Source</a>
            </div>
        </div>
        @* Razor trims the newline between the span and the closing brace, so each line ends with an explicit one. *@
        <pre class="fhir-log" id="fhir-log" aria-live="polite" aria-label="Request log" tabindex="0" @ref="_log">@foreach (var line in _lines)
{<span class="@(line.Kind.Length == 0 ? null : "fhir-log-" + line.Kind)">@line.Text</span>@("\n")}</pre>
        <details class="fhir-dto" id="fhir-dto-details">
            <summary>The @(_dtoName ?? "DTO") the function returned</summary>
            <pre class="fhir-log fhir-dto-body" id="fhir-dto" tabindex="0">@_dtoJson</pre>
        </details>
        <pre class="fhir-log fhir-raw" id="fhir-raw" hidden="@(!_rawOpen)" tabindex="0" aria-label="Raw FHIR bundle">@_rawText</pre>
    </section>
</div>
